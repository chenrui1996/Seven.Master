@@ -0,0 +1,16 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Seven.Infrastructure.Configuration;
+
+namespace Seven.Infrastructure.Wcs;
+
+/// <summary>WCS/WMS DI 注册（Phase A 骨架）</summary>
+public static class WcsServiceCollectionExtensions
+{
+    /// <summary>按 Features.Wms / WcsPacks 预留扩展点；Phase A 仅读取配置</summary>
+    public static IServiceCollection AddSevenWcs(this IServiceCollection services, IConfiguration configuration)
+    {
+        _ = configuration.GetSection(FeatureOptions.SectionName).Get<FeatureOptions>() ?? new FeatureOptions();
+        return services;
+    }
+}
diff --git a/Seven.Net8/Seven.Tests/Wcs/FeatureOptionsWcsTests.cs b/Seven.Net8/Seven.Tests/Wcs/FeatureOptionsWcsTests.cs
new file mode 100644
index 0000000..ce40f57
--- /dev/null
+++ b/Seven.Net8/Seven.Tests/Wcs/FeatureOptionsWcsTests.cs
@@ -0,0 +1,34 @@
+using FluentAssertions;
+using Seven.Infrastructure.Configuration;
+using Xunit;
+
+namespace Seven.Tests.Wcs;
+
+public class FeatureOptionsWcsTests
+{
+    [Fact]
+    public void IsEnabled_ShouldRead_NestedPack_ViaFlatName_OrExplicit()
+    {
+        var f = new FeatureOptions
+        {
+            Wms = true,
+            OrchestrationBus = true,
+            WcsPacks = new WcsPackFeatureOptions { Stacker = true, FourWay = false }
+        };
+        f.Wms.Should().BeTrue();
+        f.WcsPacks.Stacker.Should().BeTrue();
+        f.WcsPacks.FourWay.Should().BeFalse();
+    }
+
+    [Fact]
+    public void IsWcsPackEnabled_ShouldResolve_PackName()
+    {
+        var f = new FeatureOptions
+        {
+            WcsPacks = new WcsPackFeatureOptions { Stacker = true, FourWay = false }
+        };
+        f.IsWcsPackEnabled("Stacker").Should().BeTrue();
+        f.IsWcsPackEnabled("FourWay").Should().BeFalse();
+        f.IsWcsPackEnabled("Unknown").Should().BeFalse();
+    }
+}
