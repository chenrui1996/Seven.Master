{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=SevenDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnectionString": "127.0.0.1:6379",
    "DelayedDeleteMs": 500
  },
  "Jwt": {
    "Secret": "SevenMasterJwtSecretKey2026MustBe32Chars!",
    "Issuer": "Seven",
    "Audience": "Seven",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "MinIO": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "seven",
    "UseSsl": false
  },
  "Cors": {
    "Origins": "http://localhost:5173,http://localhost:8080"
  },
  "MessageQueue": {
    "Provider": "None",
    "EnableConsumers": true,
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    }
  },
  "Alarm": {
    "Codes": [
      {
        "Code": "WCS001",
        "Message": "设备 {DeviceName} 通信超时",
        "Level": 3,
        "Category": "WCS",
        "Remark": "WCS 设备通信异常"
      },
      {
        "Code": "WCS002",
        "Message": "堆垛机 {DeviceName} 任务执行失败",
        "Level": 3,
        "Category": "WCS",
        "Remark": "堆垛机任务失败"
      },
      {
        "Code": "WMS001",
        "Message": "库位 {Location} 库存异常",
        "Level": 2,
        "Category": "WMS",
        "Remark": "库存校验告警"
      },
      {
        "Code": "DEV001",
        "Message": "PLC {DeviceName} 联机断开",
        "Level": 4,
        "Category": "Device",
        "Remark": "PLC 断连"
      },
      {
        "Code": "SYS001",
        "Message": "系统异常：{Detail}",
        "Level": 4,
        "Category": "System",
        "Remark": "未捕获系统异常"
      }
    ]
  }
}
